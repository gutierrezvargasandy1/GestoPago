            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y token', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "R1. Servicios del catálogo de PuntoRed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalogo/servicios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "catalogo",
                "servicios"
              ]
            },
            "description": "Catalogo sincronizado con getProductList al arrancar. Guarda el primer servicio en la variable idServicioReal (cambiala si quieres otro)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const servicios = pm.response.json();",
                  "pm.test('hay servicios sincronizados', () => pm.expect(servicios.length).to.be.above(0));",
                  "if (servicios.length) { pm.collectionVariables.set('idServicioReal', servicios[0].idServicio); }"
                ]
              }
            }
          ]
        },
        {
          "name": "R2. Productos del servicio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalogo/servicios/{{idServicioReal}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "catalogo",
                "servicios",
                "{{idServicioReal}}",
                "productos"
              ]
            },
            "description": "Guarda el primer producto de monto fijo en las variables idProductoReal y montoReal."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const productos = pm.response.json();",
                  "const fijo = productos.find(p => p.tipoMonto === 'FIJO') || productos[0];",
                  "if (fijo) {",
                  "  pm.collectionVariables.set('idProductoReal', fijo.idProducto);",
                  "  pm.collectionVariables.set('montoReal', fijo.montoFijo || fijo.montoMinimo);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "R3. Pagar un producto real",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{clave}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pagos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pagos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"1000000001\",\n  \"idServicio\": \"{{idServicioReal}}\",\n  \"idProducto\": \"{{idProductoReal}}\",\n  \"referencia\": \"{{telefonoPrueba}}\",\n  \"monto\": {{montoReal}}\n}"
            },
            "description": "Usa el telefono o la referencia de prueba que indique PuntoRed (variable telefonoPrueba)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('clave', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "if (cuerpo.transaccionId) { pm.collectionVariables.set('ultimoId', cuerpo.transaccionId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "08. Consultar el último pago",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pagos/{{ultimoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pagos",
                "{{ultimoId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
