{
  "info": {
    "name": "Pagos de servicios - PuntoRed (GestoPago)",
    "description": "Dos carpetas: 'Simulador' (perfil demo: docker compose up -d y la API con --spring.profiles.active=demo) y 'Proveedor real' (perfil datos-demo con las credenciales de PuntoRed en el .env). En cada carpeta ejecuta primero el login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "clave",
      "value": ""
    },
    {
      "key": "ultimoId",
      "value": ""
    },
    {
      "key": "idServicioReal",
      "value": ""
    },
    {
      "key": "idProductoReal",
      "value": ""
    },
    {
      "key": "montoReal",
      "value": ""
    },
    {
      "key": "telefonoPrueba",
      "value": "5512345678"
    }
  ],
  "item": [
    {
      "name": "Simulador (perfil demo)",
      "item": [
        {
          "name": "01. Login (ana / Demo-2026!)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"ana\",\n  \"password\": \"Demo-2026!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y token', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "02. Catálogo de Telcel",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalogo/servicios/TAE_TELCEL/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "catalogo",
                "servicios",
                "TAE_TELCEL",
                "productos"
              ]
            }
          }
        },
        {
          "name": "03. Pago aprobado (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{clave}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pagos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pagos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"1000000001\",\n  \"idServicio\": \"TAE_TELCEL\",\n  \"idProducto\": \"TEL_100\",\n  \"referencia\": \"5512345678\",\n  \"monto\": 100.0\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('clave', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "if (cuerpo.transaccionId) { pm.collectionVariables.set('ultimoId', cuerpo.transaccionId); }",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "04. Repetir el pago anterior con la MISMA clave (200, no cobra)",
