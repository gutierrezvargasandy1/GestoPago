            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 repetido', () => pm.response.to.have.status(200));",
                  "pm.test('Idempotent-Replayed', () => pm.response.to.have.header('Idempotent-Replayed'));"
                ]
              }
            }
          ]
        },
