            },
            "description": "El simulador responde el codigo 02 de PuntoRed (saldo insuficiente del distribuidor). La operacion no se aplico: el monto se devuelve a la cuenta."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('clave', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "if (cuerpo.transaccionId) { pm.collectionVariables.set('ultimoId', cuerpo.transaccionId); }",
                  "pm.test('422 PAGO_RECHAZADO', () => pm.expect(cuerpo.codigo).to.eql('PAGO_RECHAZADO'));"
                ]
              }
            }
          ]
        },
